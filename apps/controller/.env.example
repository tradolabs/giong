# string required | Generate a 32-byte key: openssl rand -base64 32
GIONG_ENCRYPTION_KEY=

# string required | Secret used to verify GitHub webhook signatures
GIONG_GITHUB_WEBHOOK_SECRET=

# string required | Secret used to sign and verify JWT token
GIONG_JWT_SECRET=

# boolean default=false | Enable scheduled jobs
GIONG_SCHEDULE_ENABLED=false

# url optional | Remote database URL (fallback: local SQLite)
GIONG_DATABASE_URL=

# url optional | Cloud storage URL for completed job logs
GIONG_STORAGE_URL=

# string required default=* | Allowed browser origin (use * for all origins)
GIONG_CORS_ORIGIN=*
